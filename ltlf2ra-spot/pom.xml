<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <artifactId>ltlf2ra-spot</artifactId>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>machine-decomposition</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>


    <!-- DEPENDENCIES -->

    <dependencies>

        <!-- LTLf / Residual Automaton core -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>ltlf2ra-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!-- COMMON BUILD  -->

    <build>

        <plugins>

            <!-- Java compilation + JNI header generation  -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>

                <configuration>
                    <release>21</release>

                    <compilerArgs>
                        <arg>-h</arg>
                        <arg>
                            ${project.build.directory}/generated-sources/headers
                        </arg>
                    </compilerArgs>
                </configuration>
            </plugin>


            <!-- CMake + Ninja -->

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>

                <executions>

                    <!-- CMake configure -->
                    <execution>
                        <id>configure-native</id>

                        <phase>process-classes</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>

                            <!-- CMake must be available on PATH -->
                            <executable>cmake</executable>

                            <workingDirectory>
                                ${project.basedir}
                            </workingDirectory>

                            <arguments>

                                <argument>-S</argument>
                                <argument>${project.basedir}</argument>

                                <argument>-B</argument>
                                <argument>
                                    ${project.build.directory}/native-build
                                </argument>

                                <argument>-G</argument>
                                <argument>Ninja</argument>

                                <argument>
                                    -DJNI_GENERATED_HEADERS=${project.build.directory}/generated-sources/headers
                                </argument>

                            </arguments>

                        </configuration>
                    </execution>


                    <!-- CMake build -->
                    <execution>
                        <id>build-native</id>

                        <phase>process-classes</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>

                            <executable>cmake</executable>

                            <workingDirectory>
                                ${project.basedir}
                            </workingDirectory>

                            <arguments>

                                <argument>--build</argument>

                                <argument>
                                    ${project.build.directory}/native-build
                                </argument>

                            </arguments>

                        </configuration>
                    </execution>

                </executions>
            </plugin>

        </plugins>

    </build>


    <!-- platform Specific test runtime  -->

    <profiles>

        <!-- WINDOWS -->

        <profile>
            <id>windows</id>

            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.6.0</version>

                        <configuration>

                            <argLine>
                                -Djava.library.path=${project.build.directory}/native-build/native
                            </argLine>

                            <environmentVariables>
                                <PATH>
                                    ${project.build.directory}/native-build/native;${env.SPOT_HOME}/bin;${env.PATH}
                                </PATH>
                            </environmentVariables>

                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>


        <!-- LINUX -->

        <profile>
            <id>linux</id>

            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.6.0</version>

                        <configuration>

                            <argLine>
                                -Djava.library.path=${project.build.directory}/native-build/native
                            </argLine>

                            <environmentVariables>
                                <LD_LIBRARY_PATH>
                                    ${project.build.directory}/native-build/native:${env.SPOT_HOME}/lib
                                </LD_LIBRARY_PATH>
                            </environmentVariables>

                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>


        <!-- MACOS -->

        <profile>
            <id>macos</id>

            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.6.0</version>

                        <configuration>

                            <argLine>
                                -Djava.library.path=${project.build.directory}/native-build/native
                            </argLine>

                            <environmentVariables>
                                <DYLD_LIBRARY_PATH>
                                    ${project.build.directory}/native-build/native:${env.SPOT_HOME}/lib
                                </DYLD_LIBRARY_PATH>
                            </environmentVariables>

                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

    </profiles>

</project>